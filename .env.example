# LLM API Keys (100% Free Tiers Available)
# Option 1: Groq Cloud API (Recommended: Ultra-fast & Free) -> https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: Google Gemini API (Free Tier: 15 RPM) -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 3: OpenAI (Optional fallback if you have credits)
OPENAI_API_KEY=

# --- Backend (FastAPI) only — see README's "Production Architecture" section ---

# Firebase Admin SDK credentials: use EITHER the path (local dev) OR the
# inline JSON (recommended for hosts with an ephemeral disk, e.g. Render —
# paste the whole service account JSON as one line into the platform's env var UI).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloud Storage bucket holding the durable copy of each user's SQLite file
# (same value as the frontend's NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET).
FIREBASE_STORAGE_BUCKET=

# Comma-separated list of allowed frontend origins, e.g.:
# http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
